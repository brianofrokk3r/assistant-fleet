# Copy to .env.console. Never commit the populated file.
#
# secret://slack/acme-app-token resolves to FLEET_SECRET_SLACK_ACME_APP_TOKEN.
# env://MY_TOKEN resolves directly to MY_TOKEN.
# file:///run/secrets/acme-slack-app-token reads that mounted file at action time.

# FLEET_SECRET_SLACK_APP_TOKEN=xapp-...
# FLEET_SECRET_SLACK_BOT_TOKEN=xoxb-...
# Per-tenant references such as secret://slack/second-tenant/app-token use:
# FLEET_SECRET_SLACK_SECOND_TENANT_APP_TOKEN=xapp-...
# FLEET_SECRET_SLACK_SECOND_TENANT_BOT_TOKEN=xoxb-...
# FLEET_SECRET_DISCORD_BOT_TOKEN=...
# FLEET_SECRET_CODEX_CREDENTIAL=sk-...

# A migrated tenant may also reference narrowly scoped integration secrets:
# FLEET_SECRET_TYPESAFE_TENANT_API_KEY=...
# FLEET_SECRET_N8N_TENANT_INTAKE_TOKEN=...
